pkgname=webmfix
pkgver=1.1.0
pkgrel=1
pkgdesc='Repair missing audio headers in WebM videos with a small Qt interface'
arch=('x86_64' 'aarch64')
license=('MIT')
options=('!debug')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'xdg-desktop-portal' 'python' 'ffmpeg')
makedepends=('gcc' 'make')
source=()
sha256sums=()
build() {
    cd "$startdir/.."
    ./bin/build
}
package() {
    cd "$startdir/.."
    install -Dm755 build/webmfix "$pkgdir/usr/bin/webmfix"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$startdir/webmfix.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/webmfix.svg"
    install -Dm644 "$startdir/webmfix.desktop" "$pkgdir/usr/share/applications/webmfix.desktop"
}
